// ==========================================
// CONFIG
// ==========================================

var MAX_WEIGHT_PERCENT = 60;

// SHOVEL SERIAL (do seu macro)
var SHOVEL_SERIAL = '0x7C2478DA';

// Clay location FIXO
var CLAY_X = 2293;
var CLAY_Y = 1198;
var CLAY_Z = 0;

// Bank location FIXO
var BANK_X = 2276;
var BANK_Y = 1200;
var BANK_Z = 0;

var BANKER_SERIAL = '0x006AD500';

// ==========================================
// MAIN
// ==========================================

function AutoClay()
{
    Orion.Print("Auto Clay iniciado.");

    while (true)
    {
        // Vai para o ponto do clay
        GoTo(CLAY_X, CLAY_Y, CLAY_Z);

        // Minera até ficar pesado
        MineClay();

        // Se estiver pesado → banco
        if (IsHeavy())
        {
            Orion.Print("Indo ao banco...");
            GoBank();
        }

        Orion.Wait(500);
    }
}

// ==========================================
// MINERAR CLAY (IGUAL AO MACRO)
// ==========================================

function MineClay()
{
    while (!IsHeavy())
    {
        if (Player.Dead())
            return;

        Orion.ClearJournal();
        var time = Orion.Now();

        Orion.UseObject(SHOVEL_SERIAL);

        if (Orion.WaitForTarget(2000))
            Orion.TargetTile('any', 2293, 1198, 0);

        Orion.WaitJournal(
            "There is no more|You stop mining|You fail to find|You cant dig with this here",
            time,
            Orion.Now() + 10000
        );

        if (Orion.InJournal("There is no more"))
        {
            Orion.Print("Sem clay no local.");
            return;
        }

        Orion.Wait(400);
        Orion.ClearJournal();
    }
}

// ==========================================
// BANCO
// ==========================================

function GoBank()
{
    // Vai até a posição do banco
    Orion.WalkTo(2277, 1198, 0);
    Orion.Wait(1000);

    // Vai até o banker pelo serial real
    var banker = Orion.FindObject('0x006AD500');

    if (!banker)
    {
        Orion.Print("Banker não encontrado.");
        return;
    }

    //Orion.WalkTo(banker.X(), banker.Y(), banker.Z());
    Orion.Wait(1000);

    // Abre o banco
    Orion.UseObject('0x006AD500');
    Orion.Wait(1000);

    var bank_gump = Orion.GetLastGump();

    if (bank_gump)
    {
        bank_gump.Select(Orion.CreateGumpHook(1));
        Orion.Wait(1000);
    }

    DepositClay();

    Orion.Print("Clay guardado. Voltando...");
}

// ==========================================
// DEPOSITAR CLAY
// ==========================================

function DepositClay()
{
    // COLOQUE AQUI O TYPE DO CLAY
    var clay = Orion.FindType('0x1BE9', any, backpack);

    if (clay)
    {
        for (var i = 0; i < clay.length; i++)
        {
            Orion.MoveItem(clay[i], 0, Player.BankSerial());
            Orion.Wait(800);
        }
    }
}

// ==========================================
// MOVIMENTO
// ==========================================

function GoTo(x, y, z)
{
    Orion.WalkTo(x, y, z);

    var timeout = Orion.Now() + 10000;

    while (Orion.GetDistance(x, y) > 1)
    {
        if (Orion.Now() > timeout)
            break;

        Orion.Wait(100);
    }
}

// ==========================================
// PESO 60%
// ==========================================

function IsHeavy()
{
    var percent = (Player.Weight() * 100) / Player.MaxWeight();

    if (percent >= MAX_WEIGHT_PERCENT)
        return true;

    return false;
}

