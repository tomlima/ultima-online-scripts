//=============================
// This function apply bands to yourself 
// and add a timer to screen. 
//==============================

function BandageSelf(){
	if (!Orion.DisplayTimerExists("bandage")){
    	if (Player.Hits() < Player.MaxHits())
    	{
        	var delay = 15
        	var dex = Player.MaxStam()
        	delay = (delay - (dex / 20) + 1) * 1000;
        
        	Orion.UseType('0x0E21');
        	if (Orion.WaitForTarget(2000))
            	Orion.TargetObject('self');
        	Orion.AddDisplayTimer("bandage", delay, 'LeftTop', 'Bar', "Bandage", 600, 150, '0x2C', 1, 'white');
    	}
    	else
    	{
        	Orion.Print("You are full health");
    	}
	}
}


//==============================
// Function to wear quip one by saying .quip 1
//==============================
function WearQuipOne(){
	if(Orion.GetGlobal("quip") != 1){
		Orion.Say(".quip 1");
		Orion.SetGlobal("quip", 1);
	}
}


//==============================
// Function to wear quip one by saying .quip 2
//==============================
function WearQuipTwo(){
    if(Orion.GetGlobal("quip") != 2){
    	Orion.Say(".quip 2"); 
    	Orion.SetGlobal("quip", 2);
    } 
}

//==============================
// Function to wear quip one by saying .quip3
//==============================
function WearQuipTree(){
	if(Orion.GetGlobal("quip") !== 3){
		Orion.Say(".quip 3");
		Orion.SetGlobal("quip", 3);
	}
}

//================================
// Get all target in your vision
// ================================
function GetTargets(){
	Orion.SetGlobal('posX', 1235);   							// Put here the initial X position of first target 
	Orion.SetGlobal('posY', 250);    							// Put here the initial Y position of first target 
	Orion.SetGlobal('column', 0);   							// Variable to control columns. Dont touch!!
	var distance = 200;                       					// Put here the total distance in tiles to find targets 
	var spaceBetweenTargets = 70;    						// Put here the space between each target
	var ignoreMyself = 1;                  						// 1 = ignore yourself | 0 = count yourself
	var onlyPlayers = false;               						// true = only players targets | false = all live targets	
	
	 
	if(!onlyPlayers){
		var targets = '0xFFFF';
	}else{
		var targets = '0x0190';
	}
	
	var players = Orion.FindType(targets, '0xFFFF', 'any','mobile', distance );
    if(players && players.length > 0){
    	for(var i = 0; i < players.length; i++){
    		var posX = Orion.GetGlobal('posX'); 
    		var posY = Orion.GetGlobal('posY'); 
    		
    		if(ignoreMyself == 1){
    			if( Player.Serial() != players[i] ){
    				Orion.ShowStatusbar(players[i], posX,posY);
    				Orion.SetGlobal('posY', parseInt(posY) + spaceBetweenTargets);
    				if(parseInt(Orion.GetGlobal('column')) >= 9){
    					Orion.SetGlobal('posX', parseInt(posX) - 200);
    					Orion.SetGlobal('column', 0);
    					Orion.SetGlobal('posY', 150);
    				} 
    			}
    		}else{
    			Orion.ShowStatusbar(players[i], posX,posY); 
    			Orion.SetGlobal('posY', parseInt(posY) + spaceBetweenTargets);
				if(parseInt(Orion.GetGlobal('column')) >= 9){
    				Orion.SetGlobal('posX', parseInt(posX) + - 200);
    				Orion.SetGlobal('column', 0);
    				Orion.SetGlobal('posY', 150);
    			} 
    		}
    		Orion.SetGlobal('column', parseInt(Orion.GetGlobal('column')) + 1);
    	}
    }
}

// ============================
// This Function cast a set of buff skills and 
// Adds a timer with duration of  each spell.
// ============================

function Buffs(){
	WearQuipTwo();
	// Cast Agility
	Orion.Cast('Agility');
	Orion.WaitForTarget(3000);
	Orion.TargetObject('self');
	Orion.AddDisplayTimer(1111,240000,'LeftBottom', 'Bar', "Agility", 10,0,'0x2C',1,'orange');
	Orion.Wait(100);
	
	// Cast Strength
	Orion.Cast('Strength');
	Orion.WaitForTarget(3000);
	Orion.TargetObject('self');
	Orion.AddDisplayTimer(2222,240000, 'LeftBottom', 'Bar', "Strength", 80, 0, '0x2C', 1, 'orange');
	Orion.Wait(100);
	
	// Protection
	Orion.Cast('Protection');
	Orion.WaitForTarget(3000);
	Orion.TargetObject('self');
	Orion.AddDisplayTimer(3333,240000, 'LeftBottom', 'Bar', "Protection", 150, 0, '0x2C', 1,'orange');
	Orion.Wait(100);
	
	// Cunning
	Orion.Cast('Cunning');
	Orion.WaitForTarget(3000); 
	Orion.TargetObject('self');
	Orion.AddDisplayTimer(4444, 240000, 'LeftBottom', 'Bar', 'Cunning', 220, 0, '0x2C', 1, 'orange');
	Orion.Wait(100);
}




// ------------------------------------------------------
// GreaterHeal 
// This function cast Greater Heal spell on yourself. 
// -------------------------------------------------------
function GreaterHeal(){
 WearQuipTwo();
 Orion.Wait(200);
 Orion.Cast("Greater Heal"); 
 Orion.WaitForTarget(3000);
 Orion.TargetObject('self'); 
 Orion.Wait(100);
}


// -----------------------------------------------
// CureSelf 
// This function cast cure spell on yourself
// ------------------------------------------------
function CureSelf(){
  WearQuipTwo();
  Orion.Wait(200);	
  Orion.Cast("Cure"); 
  Orion.WaitForTarget(3000); 
  Orion.TargetObject('self'); 
  Orion.Wait(100);
}

// -------------------------------------------------
// Drink Cure 
// This function drink a cure potion 
// and add a timer of 15 seconds 
// -----------------------------------------------------
function DrinkCure(){
	var pots = Orion.FindType("0x0F07", "0xFFFF", "backpack");
	if(pots && pots.length > 0){
		Orion.UseType('0x0F07', '0xFFFF'); 
		Orion.AddDisplayTimer(6666,15000, 'LeftTop', 'Bar', "Cure Pot", 700, 150, '0x2C', 1 , 'green' );
		Orion.Wait(200); 
		if(Orion.DisplayTimerExists("bandage")) {
	   		Orion.RemoveDisplayTimer('bandage');
		}
	}
}

// ---------------------------------------------------
// Drink Heal 
// This function drink a heal potion
// and add a timer of 15 seconds 
// ----------------------------------------------------
function DrinkHeal(){
	var pots = Orion.FindType("0x0F0C", "0xFFFF","backpack"); 
	if(pots && pots.length > 0){
		Orion.UseType('0x0F0C', '0xFFFF'); 
		Orion.AddDisplayTimer(1111,15000, 'LeftTop', 'Bar', 'Heal Pot', 800, 150, '0x2C', 1, 'yellow');
		if(Orion.DisplayTimerExists('bandage')){
			Orion.RemoveDisplayTimer("bandage");
		}
	}
}


// ============================
// Poisoning 
// This function applies a poison potion
// into your weapon
// ============================
function Poisoning(){
	Orion.UseSkill('30'); 
	Orion.WaitForTarget(1000); 
	Orion.TargetType('0x0F0A', '0xFFFF'); 
	Orion.WaitForTarget(1000); 
	Orion.TargetObject('self');
	if(Orion.DisplayTimerExists("bandage")){
	   Orion.RemoveDisplayTimer("bandage")
	}
}


