// ==========================================
// This function use provocation
// ==========================================

function Provocation() {
 	Orion.UseSkill("Provocation");
}


// ==========================================
// This function just  follow a target.
// ==========================================

function FollowTarget() {
 	Orion.AddObject('target');
	Orion.WaitWhileTargeting(); 
	Orion.Follow('target');
}


// ==========================================
// This recall to home
// ==========================================

function RecallHome(){
	Orion.Say(".quip 2"); 
	Orion.Wait(300);
	Orion.Cast("Recall");
	if (Orion.WaitForTarget(3000))
    {
        Orion.TargetObject("0x7AD77C6C");
    }
}