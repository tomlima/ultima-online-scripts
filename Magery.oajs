// ===== CONFIGURAÇÃO =====
const MEDIT_SKILL = '46'; // Meditation
const spell = 51; // mass curse
const BANDAGE_TYPE = '0x0E21';

const START_MEDIT_AT = Player.MaxMana() * 0.65;
const MIN_LIFE_PERCENT = 60;


// ===== HEAL CONTÍNUO =====
function EmergencyHeal()
{
    while (!Player.Dead() &&
          ((Player.Hits() / Player.MaxHits()) * 100) < MIN_LIFE_PERCENT)
    {
        Orion.Print("Vida abaixo de 50%! Curando...");

        Orion.UseType(BANDAGE_TYPE);
        Orion.WaitForTarget(2000);
        Orion.TargetObject(Player.Serial());

        Orion.Wait(3200);
    }
}


// ===== FUNÇÃO PRINCIPAL =====
function main()
{
    Orion.WaitForAddObject('target', 5000);
    var target = Orion.FindObject('target');

    while (!Player.Dead())
    {
        // PRIORIDADE MÁXIMA: HEAL
        EmergencyHeal();

        // =========================
        // CAST
        // =========================
        if (Player.Mana() > START_MEDIT_AT)
        {
            Orion.Cast(spell);

            if (Orion.WaitJournal('spell|fizzles', Orion.Now(), Orion.Now() + 2000, 'me|sys') ||
                Orion.WaitForTarget(3000))
            {
                Orion.TargetObject(target.Serial());
            }

            Orion.Wait(500);
            continue;
        }

        // =========================
        // MEDIT ATÉ 100%
        // =========================
        while (Player.Mana() < Player.MaxMana())
        {
            EmergencyHeal(); // protege enquanto medita

            Orion.UseSkill(MEDIT_SKILL);
            Orion.Wait(500);
        }

        Orion.Wait(300);
    }
}
